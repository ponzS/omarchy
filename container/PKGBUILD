# The desktop itself always comes from the official Omarchy repository.
# This package owns only the container policy. Desktop applications are image
# defaults, not hard dependencies: upstream migrations may replace them.
pkgname=lightos-omarchy-container
pkgver=1.0.0
pkgrel=2
pkgdesc='LightOS container integration for official Omarchy updates'
arch=('x86_64')
url='https://github.com/ponzS/omarchy'
license=('MIT')
depends=('omarchy' 'python' 'systemd' 'seatd')
install=lightos-omarchy-container.install
source=('pacman-container.conf' 'lightos-omarchy-enable-updates')
sha256sums=('SKIP' 'SKIP')
options=(!debug)

package() {
  install -Dm644 "$srcdir/pacman-container.conf" \
    "$pkgdir/usr/share/lightos-omarchy/pacman-container.conf"
  install -Dm755 "$srcdir/lightos-omarchy-enable-updates" \
    "$pkgdir/usr/bin/lightos-omarchy-enable-updates"
}
